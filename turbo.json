{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["turbo.json", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/db/prisma/schema.prisma"],
      "outputs": ["dist/**", "src/db/prisma/generated/**"],
      "outputLogs": "errors-only"
    },
    "build:docker": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build", "build"],
      "outputLogs": "errors-only"
    },
    "lint:fix": {
      "dependsOn": ["^build", "build"],
      "outputLogs": "errors-only"
    },
    "lint:openapi": {
      "dependsOn": [],
      "outputLogs": "errors-only"
    },
    "format": {
      "dependsOn": [],
      "outputLogs": "errors-only"
    },
    "format:fix": {
      "dependsOn": [],
      "outputLogs": "errors-only"
    },
    "type-check": {
      "dependsOn": ["^build", "build"],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputLogs": "errors-only"
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "check-dist": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
