{
  "name": "jobnik-manager",
  "version": "0.2.1",
  "private": true,
  "description": "This is jobnik management server",
  "main": "./src/index.ts",
  "dockerfile": "docker/backend.Dockerfile",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test:unit": "vitest run --coverage.enabled=false --project unit",
    "test:integration": "vitest run --coverage.enabled=false --project integration",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run clean && npm run migration:generate-types",
    "build": "tsc --project tsconfig.build.json && npm run prisma:copy && tsc-alias -p tsconfig.build.json && npm run assets:copy",
    "build:docker": "docker buildx build --build-arg APP_NAME=$npm_package_name -f ../../docker/backend.Dockerfile -t ${DOCKER_REGISTRY:-}${npm_package_name}:${DOCKER_TAG:-latest} ${DOCKER_FLAGS:-} ../..",
    "build:docker-no-cache": "cross-env DOCKER_FLAGS=--no-cache npm run build:docker",
    "start": "npm run build && cd dist && node --import ./instrumentation.mjs ./index.js",
    "start:dev": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true  node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles ./package.json dist && copyfiles -u 4 \"./src/db/prisma/migrations/**/*\" ./dist/db/prisma/migrations && copyfiles -f ./src/db/prisma/schema.prisma ./dist/db/prisma",
    "prisma:copy": "node ./scripts/copyDirectories.mjs ./src/db/prisma/generated ./dist/db/prisma/generated",
    "clean": "rimraf dist",
    "generate:openapi-errors": "node scripts/generateOpenApiErrors.mts",
    "generate:check": "npm run generate:openapi-errors && git diff --exit-code -- src/common/generated/errors.ts",
    "type-check": "tsc --noEmit",
    "migration:validate": "npx prisma validate --schema ./src/db/prisma/schema.prisma  ",
    "migration:format": "npx prisma format --check --schema ./src/db/prisma/schema.prisma  ",
    "migration:format-fix": "npx prisma format --schema ./src/db/prisma/schema.prisma  ",
    "migration:dev": "npx prisma migrate dev --schema ./src/db/prisma/schema.prisma",
    "migration:generate": "npx prisma migrate dev --schema ./src/db/prisma/schema.prisma --name ",
    "migration:generate-types": "npx prisma generate --schema ./src/db/prisma/schema.prisma",
    "migration:generate-sql-types": "npx prisma generate --sql --schema ./src/db/prisma/schema.prisma",
    "migration:deploy": "npx prisma migrate deploy --schema ./src/db/prisma/schema.prisma"
  },
  "directories": {
    "test": "tests"
  },
  "author": "MapColonies",
  "license": "ISC",
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/error-express-handler": "^4.0.0",
    "@map-colonies/express-access-log-middleware": "^4.0.0",
    "@map-colonies/js-logger": "catalog:",
    "@map-colonies/openapi-express-viewer": "^5.0.0",
    "@map-colonies/openapi-helpers": "catalog:",
    "@map-colonies/prometheus": "^1.0.0",
    "@map-colonies/read-pkg": "catalog:",
    "@map-colonies/schemas": "^1.24.0",
    "@map-colonies/semantic-conventions": "catalog:",
    "@map-colonies/tracing": "^1.0.0",
    "@map-colonies/tracing-utils": "^1.0.0",
    "@opentelemetry/api": "catalog:",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@prisma/instrumentation": "^6.19.0",
    "compression": "^1.8.1",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "express-openapi-validator": "^5.6.0",
    "http-status-codes": "catalog:",
    "jobnik-openapi": "workspace:*",
    "lodash": "^4.17.21",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "prom-client": "catalog:",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@map-colonies/eslint-config": "catalog:",
    "@map-colonies/prettier-config": "catalog:",
    "@map-colonies/tsconfig": "catalog:",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@types/compression": "^1.7.5",
    "@types/date-fns": "^2.5.3",
    "@types/express": "^4.17.17",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/lodash": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "@vitest/ui": "catalog:",
    "copyfiles": "catalog:",
    "cross-env": "^10.1.0",
    "docker-compose": "catalog:",
    "eslint": "catalog:",
    "get-port-please": "^3.2.0",
    "is-ci": "catalog:",
    "jest-extended": "catalog:",
    "jest-openapi": "^0.14.2",
    "prettier": "catalog:",
    "prisma": "^6.19.0",
    "prisma-json-types-generator": "^3.6.2",
    "rimraf": "catalog:",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.11",
    "type-fest": "^4.38.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "^3.1.0",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=24"
  }
}
