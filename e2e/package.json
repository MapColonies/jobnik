{
  "name": "jobnik-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "e2e test for the Jobnik platform",
  "scripts": {
    "e2e": "vitest run",
    "e2e:watch": "vitest watch",
    "e2e:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapColonies/jobnik-e2e.git"
  },
  "author": "infra-team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MapColonies/jobnik-e2e/issues"
  },
  "homepage": "https://github.com/MapColonies/jobnik-e2e#readme",
  "dependencies": {
    "@map-colonies/jobnik-sdk": "workspace:*",
    "@map-colonies/tsconfig": "^1.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.1.0",
    "@opentelemetry/core": "^2.1.0",
    "@types/node": "^24.6.0",
    "prom-client": "^15.1.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@map-colonies/eslint-config": "^9.0.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vitest/ui": "^3.2.4",
    "docker-compose": "^1.3.0",
    "eslint": "^10.0.0",
    "is-ci": "^4.1.0",
    "jobnik-manager": "workspace:*",
    "prettier": "^3.9.5"
  }
}
