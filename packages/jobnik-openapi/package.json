{
  "name": "jobnik-openapi",
  "version": "0.2.1",
  "private": true,
  "description": "The Jobnik OpenAPI specification, its versioned build and its generated request/response types",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint:openapi": "openapi lint ./openapi3.yaml",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.build.json && copyfiles -f ./openapi3.yaml ./src/openapi.d.ts ./dist",
    "clean": "rimraf dist",
    "generate:openapi-build": "node scripts/generateVersionedOpenApi.mts",
    "generate:openapi-types": "node scripts/generateTypes.mts",
    "generate": "npm run generate:openapi-build && npm run generate:openapi-types",
    "generate:check": "npm run generate && git diff --exit-code -- openapi3.yaml src/openapi.d.ts",
    "type-check": "tsc --noEmit"
  },
  "author": "MapColonies",
  "license": "ISC",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@map-colonies/eslint-config": "catalog:",
    "@map-colonies/openapi-helpers": "catalog:",
    "@map-colonies/prettier-config": "catalog:",
    "@map-colonies/tsconfig": "catalog:",
    "@redocly/cli": "^2.12.4",
    "@types/node": "catalog:",
    "copyfiles": "catalog:",
    "eslint": "catalog:",
    "openapi-merge-cli": "^1.3.2",
    "openapi-types": "catalog:",
    "prettier": "^3.9.5",
    "rimraf": "catalog:",
    "typescript": "^5.9.3",
    "yaml": "^2.8.2"
  }
}
