{
  "name": "@map-colonies/jobnik-sdk",
  "version": "1.0.1",
  "description": "Map Colonies Jobnik SDK",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run clean && npm run copy:openapi",
    "build": "tsc --project tsconfig.build.json && copyfiles -f src/openapi3.yaml dist",
    "start": "npm run build && cd dist && node ./index.js",
    "clean": "rimraf dist",
    "copy:openapi": "node scripts/copySpec.mts",
    "generate:openapi": "node scripts/openapi.mts",
    "generate:check": "npm run generate:openapi && git diff --exit-code -- src/types/openapi.ts src/generated/openapi-errors.ts",
    "prepack": "npm run build",
    "type-check": "tsc --noEmit -p tsconfig.lint.json",
    "check-pack": "publint && attw --pack . && node scripts/checkPack.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapColonies/jobnik.git",
    "directory": "packages/jobnik-sdk"
  },
  "author": "MapColonies",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MapColonies/jobnik/issues"
  },
  "files": [
    "dist/**/*"
  ],
  "homepage": "https://github.com/MapColonies/jobnik/tree/master/packages/jobnik-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@map-colonies/eslint-config": "catalog:",
    "@map-colonies/openapi-helpers": "catalog:",
    "@map-colonies/tsconfig": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@types/node": "catalog:",
    "@types/opossum": "^8.1.9",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "copyfiles": "catalog:",
    "eslint": "catalog:",
    "jest-extended": "catalog:",
    "jobnik-openapi": "workspace:*",
    "prom-client": "catalog:",
    "publint": "^0.3.24",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@map-colonies/read-pkg": "catalog:",
    "@map-colonies/semantic-conventions": "catalog:",
    "@readme/openapi-parser": "^4.0.1",
    "http-status-codes": "catalog:",
    "openapi-fetch": "^0.14.0",
    "openapi-types": "catalog:",
    "openapi-typescript-helpers": "^0.0.15",
    "opossum": "^9.0.0",
    "undici": "^7.19.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "prom-client": "^15.0.0"
  }
}
